# Dependências — o Render roda `npm install` no deploy, então elas
# nunca precisam ir para o repositório (e são pesadas).
node_modules/

# Variáveis de ambiente. NADA de segredo entra no Git: as chaves reais
# (JWT_SECRET, SUPABASE_SERVICE_KEY, RESEND_KEY, OWNER_PASSWORD_HASH,
# ENCRYPT_SECRET, DUTTYFY_PIX_URL_ENCRYPTED) ficam só no painel do
# Render. Este projeto já teve uma API key vazada por ficar no código.
.env
.env.*
!.env.example

# Logs e artefatos de execução
*.log
npm-debug.log*
.npm/

# Sistema operacional / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
