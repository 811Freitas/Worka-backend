# Dependências — a hospedagem roda `npm install` no deploy.
node_modules/

# Segredos. Nada aqui entra no Git: JWT_SECRET, CRYPTO_KEY e
# DATABASE_URL dão acesso a tudo, e um arquivo commitado por engano
# continua no histórico para sempre, mesmo depois de apagado.
.env
.env.*
!.env.example

# Logs e artefatos de execução
*.log
npm-debug.log*
.npm/

# Sistema operacional e editores
.DS_Store
Thumbs.db
.vscode/
.idea/
