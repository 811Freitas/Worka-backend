# ════════════════════════════════════════════════════════════
# ZAPFY — variáveis de ambiente
# ════════════════════════════════════════════════════════════
# Copie para .env e preencha. O .env NUNCA vai para o Git.
#
# Para gerar um segredo aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ════════════════════════════════════════════════════════════

# ── Obrigatórias ────────────────────────────────────────────

# Postgres. Supabase, Neon, Railway e Render servem.
DATABASE_URL=postgres://usuario:senha@host:5432/zapfy

# Assina os tokens de sessão. 32 caracteres no mínimo.
# Trocar desloga todo mundo — o que é inofensivo.
JWT_SECRET=

# Cifra os tokens da Meta guardados no banco (AES-256-GCM).
#
# ATENÇÃO: esta é a única variável cuja perda é irreversível. Trocá-la
# torna ILEGÍVEIS as credenciais de todos os clientes, e cada um terá
# que reconectar o WhatsApp na mão. Guarde uma cópia em lugar seguro.
CRYPTO_KEY=

# ── Praticamente obrigatórias ───────────────────────────────

# O endereço público do serviço. É daqui que sai a URL de webhook que o
# cliente copia e cola no painel da Meta — errada aqui, ninguém conecta.
PUBLIC_URL=https://seu-dominio.com.br

# ── Painel de administração (/owner) ────────────────────────
# A conta que administra a PLATAFORMA — não é um cliente. Sem estas duas
# variáveis, /owner responde 503 e o painel simplesmente não existe, em
# vez de existir com uma senha padrão que alguém esqueceria de trocar.
#
# O hash é bcrypt, nunca a senha. Gere assim:
#   node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA',12))"
#
# ATENÇÃO ao colar no .env: um hash bcrypt tem cifrões ($2b$12$...), e o
# leitor de .env trata "$algo" como variável a expandir — o hash chega
# mutilado ao servidor e a senha certa passa a ser recusada, sem nenhuma
# mensagem que aponte para a causa. Por isso ele vai entre ASPAS SIMPLES.
# (No painel da Render, Railway e afins não há expansão: lá cole o valor
# cru, sem aspas.)
OWNER_EMAIL=
OWNER_SENHA_HASH='cole-o-hash-aqui-entre-aspas-simples'

# ── Opcionais ───────────────────────────────────────────────

PORT=3000
NODE_ENV=production

# TLS no banco. true em qualquer Postgres gerenciado (Supabase, Neon,
# Render); false num Postgres local sem certificado.
DB_SSL=true

# Horas de validade do token de sessão.
JWT_HORAS=12

# De quanto em quanto tempo o monitor pergunta à Meta se as conexões
# ainda valem. MONITOR=off desliga (só faz sentido em desenvolvimento).
MONITOR_MINUTOS=15
MONITOR=on

# Versão da Graph API. Fixada de propósito: a Meta muda formato de
# payload entre versões, e um bot que muda de comportamento sozinho num
# domingo é impossível de investigar.
GRAPH_VERSION=v22.0

# Origens liberadas no CORS, separadas por vírgula. Só é preciso quando
# o painel é servido de outro domínio — no arranjo padrão, deixe vazio.
CORS_ORIGINS=
